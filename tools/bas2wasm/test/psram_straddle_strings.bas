' On the ConeZ board the first 4 KB of a module's memory is ordinary RAM and
' the rest is SPI PSRAM, so a host import that reads a string lying across
' address 4096 gets it in two pieces (wasm_psram_glue.cpp). The eleven
' 440-character literals below fill the data segment from address 4 to about
' 5 KB, so one of them lies across that line whatever the exact layout. Each
' is read by the host in overlapping 60-character windows (one of which must
' span the line), copied whole by a concatenation, compared, measured and
' searched. A piece joined one byte off shows up as a wrong character, a
' failed comparison or a wrong position. The shorter literals after them are
' all in the PSRAM part. (More than 4 KB of literal text needs the host
' compiler; the on-device compiler stops at 4 KB.)
SUB CHECK S$, NEEDLE$
  LOCAL K, OK, T$
  FOR K = 1 TO LEN(S$) STEP 50
    > MID$(S$, K, 60)
  NEXT
  T$ = S$ + "|" + S$
  OK = 0
  IF LEFT$(T$, LEN(S$)) = S$ THEN OK = OK + 1
  IF RIGHT$(T$, LEN(S$)) = S$ THEN OK = OK + 2
  FORMAT "% % % % $", LEN(S$), INSTR(S$, NEEDLE$), LEN(T$), OK, RIGHT$(S$, 12)
  TOTAL = TOTAL + LEN(T$)
END SUB
